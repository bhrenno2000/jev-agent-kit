+  assert.deepEqual(
+    mergeWindows([
+      { start: 40, end: 70 },
+      { start: 10, end: 30 },
+      { start: 20, end: 25 },
+      { start: 30, end: 50 },
+      { start: 90, end: 100 },
+    ]),
+    [{ start: 10, end: 70 }, { start: 90, end: 100 }],
+  );
+});
+
+test("filters short leading, interior, and trailing gaps and includes the minimum duration", () => {
