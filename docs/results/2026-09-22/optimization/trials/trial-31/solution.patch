diff --git a/test/regression.test.mjs b/test/regression.test.mjs
new file mode 100644
index 0000000..6d18497
--- /dev/null
+++ b/test/regression.test.mjs
@@ -0,0 +1,215 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { createCheckout } from "../src/index.mjs";
+
+const request = (changes = {}) => ({
+  tenantId: "acme",
+  orderId: "o1",
+  sku: "widget",
+  quantity: 1,
+  idempotencyKey: "k1",
+  payload: null,
+  ...changes,
+});
+
+test("inventory preserves delimiter-bearing and prototype-like identifiers and empty tenants", async () => {
+  const inventory = JSON.parse('{"acme:west":{"widget":2},"acme":{"west:widget":3},"__proto__":{"constructor":1,"__proto__":2},"constructor":{"toString":1},"empty":{},"":{}}');
+  const system = createCheckout(inventory);
+  assert.deepEqual(system.snapshot(), { stock: inventory, orders: [] });
+  await system.checkout(request({ tenantId: "acme:west" }));
+  await system.checkout(request({ sku: "west:widget" }));
+  await system.checkout(request({ tenantId: "__proto__", sku: "__proto__" }));
+  await system.checkout(request({ tenantId: "constructor", sku: "toString" }));
+  inventory["acme:west"].widget = 1;
+  inventory.acme["west:widget"] = 2;
+  inventory.__proto__.__proto__ = 1;
+  inventory.constructor.toString = 0;
+  assert.deepEqual(system.snapshot().stock, inventory);
+  assert.deepEqual(Object.keys(system.snapshot()), ["stock", "orders"]);
+});
+
+test("canonical payload replay ignores object key order and preserves prototype-like keys", async () => {
+  const system = createCheckout({ acme: { widget: 3 } });
+  const payload = JSON.parse('{"z":[{"b":2,"a":1},3],"__proto__":{"y":2,"x":1},"constructor":{"prototype":true},"toJSON":"ordinary data"}');
+  const reordered = JSON.parse('{"toJSON":"ordinary data","constructor":{"prototype":true},"__proto__":{"x":1,"y":2},"z":[{"a":1,"b":2},3]}');
+  const first = await system.checkout(request({ payload }));
+  assert.deepEqual(first.payload, payload);
+  const before = system.snapshot();
+  assert.deepEqual(await system.checkout(request({ payload: reordered })), first);
+  assert.deepEqual(system.snapshot(), before);
+  const changed = structuredClone(reordered);
+  changed.__proto__.x = 9;
+  await assert.rejects(system.checkout(request({ payload: changed })), /idempotency conflict/);
+  assert.deepEqual(system.snapshot(), before);
+});
+
+test("conflicting order, SKU, quantity, payload, and array order leave state unchanged", async () => {
+  const system = createCheckout({ acme: { widget: 5, other: 5 } });
+  const input = request({ payload: { items: [1, 2] } });
+  const first = await system.checkout(input);
+  const before = system.snapshot();
+  for (const change of [
+    { orderId: "other" },
+    { sku: "other" },
+    { quantity: 2 },
+    { payload: { items: [2, 1] } },
+    { payload: { items: [1, 2], extra: true } },
+  ]) {
+    await assert.rejects(system.checkout({ ...input, ...change }), /idempotency conflict/);
+    assert.deepEqual(system.snapshot(), before);
+    assert.deepEqual(await system.checkout(input), first);
+  }
+});
+
+test("checkout captures identifiers, quantity, and nested payload synchronously", async () => {
+  const system = createCheckout({ acme: { widget: 2 }, other: { widget: 5 } });
+  const input = request({ payload: { items: [{ value: "original" }] } });
+  const original = structuredClone(input);
+  const pending = system.checkout(input);
+  Object.assign(input, { tenantId: "other", orderId: "mutated", sku: "missing", quantity: 4, idempotencyKey: "changed" });
+  input.payload.items[0].value = "changed";
+  input.payload.items.push(null);
+  const result = await pending;
+  assert.deepEqual(result, {
+    tenantId: "acme",
+    orderId: "o1",
+    sku: "widget",
+    quantity: 1,
+    payload: original.payload,
+    status: "confirmed",
+  });
+  assert.deepEqual(await system.checkout(original), result);
+  assert.deepEqual(system.snapshot(), {
+    stock: { acme: { widget: 1 }, other: { widget: 5 } },
+    orders: [result],
+  });
+});
+
+test("missing payload defaults to null in results, snapshots, and replays", async () => {
+  const system = createCheckout({ acme: { widget: 2 } });
+  const input = request();
+  delete input.payload;
+  const result = await system.checkout(input);
+  assert.deepEqual(result, {
+    tenantId: "acme",
+    orderId: "o1",
+    sku: "widget",
+    quantity: 1,
+    payload: null,
+    status: "confirmed",
+  });
+  assert.deepEqual(await system.checkout(request()), result);
+  assert.deepEqual(system.snapshot().orders, [result]);
+});
+
+test("constructor rejects invalid inventory containers and counts", () => {
+  for (const initial of [null, true, 1, "", [], new Date(), { acme: null }, { acme: true }, { acme: 1 }, { acme: "" }, { acme: [] }, { acme: new Date() }]) {
+    assert.throws(() => createCheckout(initial));
+  }
+  for (const count of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, "1", null, undefined]) {
+    assert.throws(() => createCheckout({ acme: { widget: count } }), /invalid inventory/);
+  }
+  assert.deepEqual(createCheckout({ acme: { zero: 0, maximum: Number.MAX_SAFE_INTEGER }, empty: {} }).snapshot(), {
+    stock: { acme: { zero: 0, maximum: Number.MAX_SAFE_INTEGER }, empty: {} },
+    orders: [],
+  });
+});
+
+test("requests must be plain objects with valid identifiers and quantities", async () => {
+  const invalid = [null, [], true, 1, "request", Object.create(request()), Object.assign(new Date(), request()), Object.assign(() => {}, request())];
+  for (const field of ["tenantId", "orderId", "sku", "idempotencyKey"]) {
+    for (const value of [undefined, null, "", 1, {}]) invalid.push(request({ [field]: value }));
+  }
+  for (const quantity of [0, -1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, "1"]) {
+    invalid.push(request({ quantity }));
+  }
+  const system = createCheckout({ acme: { widget: 2 } });
+  const before = system.snapshot();
+  for (const input of invalid) {
+    await assert.rejects(system.checkout(input), /invalid request/);
+    assert.deepEqual(system.snapshot(), before);
+  }
+});
+
+test("invalid JSON payloads reject before mutation", async () => {
+  const cycle = {};
+  cycle.self = cycle;
+  const sparse = new Array(1);
+  const disguisedSparse = new Array(1);
+  disguisedSparse.extra = true;
+  const system = createCheckout({ acme: { widget: 3 } });
+  const before = system.snapshot();
+  for (const payload of [undefined, NaN, Infinity, 1n, Symbol("payload"), () => {}, new Date(), new Map(), new Set(), { value: undefined }, { value: () => {} }, { [Symbol("key")]: 1 }, sparse, disguisedSparse, cycle]) {
+    await assert.rejects(system.checkout(request({ payload })), /invalid request/);
+    assert.deepEqual(system.snapshot(), before);
+  }
+});
+
+test("concurrent checkouts cannot oversell and orders follow successful commits", async () => {
+  const system = createCheckout({ acme: { widget: 3 } });
+  const attempts = await Promise.allSettled([
+    system.checkout(request({ orderId: "first", quantity: 2, idempotencyKey: "first" })),
+    system.checkout(request({ orderId: "too-large", quantity: 2, idempotencyKey: "too-large" })),
+    system.checkout(request({ orderId: "last", idempotencyKey: "last" })),
+    system.checkout(request({ orderId: "oversell", idempotencyKey: "oversell" })),
+  ]);
+  assert.deepEqual(attempts.map((attempt) => attempt.status), ["fulfilled", "rejected", "fulfilled", "rejected"]);
+  assert.match(attempts[1].reason.message, /insufficient stock/);
+  assert.match(attempts[3].reason.message, /insufficient stock/);
+  assert.deepEqual(system.snapshot(), {
+    stock: { acme: { widget: 0 } },
+    orders: [attempts[0].value, attempts[2].value],
+  });
+});
+
+test("persistence failures are atomic and only valid new checkouts consume the flag", async () => {
+  const system = createCheckout({ acme: { widget: 4 } });
+  const first = await system.checkout(request());
+  const before = system.snapshot();
+  system.failNextPersistence();
+  assert.deepEqual(await system.checkout(request()), first);
+  await assert.rejects(system.checkout(request({ orderId: "conflict" })), /idempotency conflict/);
+  await assert.rejects(system.checkout(request({ quantity: 0 })), /invalid request/);
+  await assert.rejects(system.checkout(request({ quantity: 4, idempotencyKey: "retry" })), /insufficient stock/);
+  assert.deepEqual(system.snapshot(), before);
+  const retry = request({ orderId: "second", idempotencyKey: "retry", quantity: 2 });
+  await assert.rejects(system.checkout(retry), /persistence failure/);
+  assert.deepEqual(system.snapshot(), before);
+  const second = await system.checkout(retry);
+  assert.deepEqual(system.snapshot(), { stock: { acme: { widget: 1 } }, orders: [first, second] });
+});
+
+test("idempotency keys are tenant scoped and independent of equal order IDs", async () => {
+  const system = createCheckout({ "acme:west": { widget: 2 }, acme: { widget: 3 } });
+  const first = await system.checkout(request({ tenantId: "acme:west", idempotencyKey: "k" }));
+  const second = await system.checkout(request({ idempotencyKey: "west:k" }));
+  const third = await system.checkout(request({ idempotencyKey: "k" }));
+  const duplicate = request({ idempotencyKey: "another", payload: [true, null, 2.5] });
+  const [fourth, replay] = await Promise.all([system.checkout(duplicate), system.checkout(duplicate)]);
+  assert.deepEqual(fourth, replay);
+  assert.deepEqual(system.snapshot(), {
+    stock: { "acme:west": { widget: 1 }, acme: { widget: 0 } },
+    orders: [first, second, third, fourth],
+  });
+});
+
+test("constructor input, results, replays, and snapshots do not expose service state", async () => {
+  const inventory = { acme: { widget: 3 }, empty: {} };
+  const system = createCheckout(inventory);
+  inventory.acme.widget = 0;
+  delete inventory.empty;
+  const input = request({ payload: JSON.parse('{"__proto__":{"items":[1]},"constructor":{"value":2}}') });
+  const first = await system.checkout(input);
+  const expected = structuredClone(first);
+  first.payload.__proto__.items.push(2);
+  first.status = "changed";
+  const replay = await system.checkout(input);
+  assert.deepEqual(replay, expected);
+  replay.payload.constructor.value = 9;
+  const snapshot = system.snapshot();
+  snapshot.stock.acme.widget = 0;
+  snapshot.stock.empty.extra = 1;
+  snapshot.orders[0].payload.__proto__.items[0] = 10;
+  snapshot.orders.push({});
+  assert.deepEqual(system.snapshot(), { stock: { acme: { widget: 2 }, empty: {} }, orders: [expected] });
+});
