+++ b/test/regression.test.mjs
@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { listCatalog } from "../src/index.mjs";
+
+test("zero limit retains the complete filtered count", () => {
+  const records = [
+    { id: "1", name: "Alpha", category: "book" },
+    { id: "2", name: "Alpine", category: "game" },
+    { id: "3", name: "ALMANAC", category: "book" },
+    { id: "4", name: "Beta", category: "book" },
+  ];
+
+  for (const offset of [0, 1, 10]) {
+    assert.deepEqual(
+      listCatalog(records, { category: "book", query: "AL", offset, limit: 0 }),
+      { items: [], total: 2, nextOffset: null },
+    );
+  }
+});
+
+test("returned records and nested values are independent of frozen inputs", () => {
+  const records = Object.freeze([
+    Object.freeze({
+      id: "1",
+      name: "Alpha",
+      category: "book",
+      details: Object.freeze({
+        tags: Object.freeze([Object.freeze({ label: "original" })]),
+      }),
+    }),
+  ]);
+  const original = structuredClone(records);
+  const result = listCatalog(records);
+
+  assert.deepEqual(result, { items: original, total: 1, nextOffset: null });
+  assert.notStrictEqual(result.items, records);
+  assert.notStrictEqual(result.items[0], records[0]);
+  assert.notStrictEqual(result.items[0].details, records[0].details);
+  result.items[0].name = "Changed";
+  result.items[0].details.tags[0].label = "changed";
+  result.items[0].details.tags.push({ label: "new" });
+  result.items.push({ id: "2", name: "Beta", category: "game" });
+
+  assert.deepEqual(records, original);
+  assert.deepEqual(listCatalog(records).items, original);
+});
+
+test("invalid pagination rejects before accessing record elements", () => {
+  const invalidValues = [null, -1, 0.5, NaN, Infinity, -Infinity, "1", true, {}, [], Number.MAX_SAFE_INTEGER + 1];
+
+  for (const field of ["offset", "limit"]) {
+    for (const value of invalidValues) {
+      let reads = 0;
+      const records = [];
+      Object.defineProperty(records, 0, {
+        get() {
+          reads += 1;
+          return { id: "1", name: "Alpha", category: "book" };
+        },
+      });
+      Object.freeze(records);
+
+      assert.throws(() => listCatalog(records, { [field]: value }));
+      assert.equal(reads, 0);
+    }
+  }
+});
+
+test("pagination defaults and safe integer boundaries preserve order", () => {
+  const records = Array.from({ length: 22 }, (_, index) => ({
+    id: String(index),
+    name: `Record ${index}`,
+    category: "book",
+  }));
+  const firstPage = { items: records.slice(0, 20), total: 22, nextOffset: 20 };
+
+  assert.deepEqual(listCatalog(records), firstPage);
+  assert.deepEqual(listCatalog(records, { offset: undefined, limit: undefined }), firstPage);
+  assert.deepEqual(listCatalog(records, { offset: 20 }), {
+    items: records.slice(20), total: 22, nextOffset: null,
+  });
+  assert.deepEqual(listCatalog(records, { offset: Number.MAX_SAFE_INTEGER }), {
+    items: [], total: 22, nextOffset: null,
+  });
+  assert.deepEqual(listCatalog(records, { limit: Number.MAX_SAFE_INTEGER }), {
+    items: records, total: 22, nextOffset: null,
+  });
+});
