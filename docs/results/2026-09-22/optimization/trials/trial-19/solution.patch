--- /dev/null
+++ b/test/regression.test.mjs
@@ -0,0 +1,84 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { listCatalog } from "../src/index.mjs";
+
+test("zero-limit pages retain the full filtered total", () => {
+  const records = [
+    { id: "1", name: "Alpha", category: "book" },
+    { id: "2", name: "Beta", category: "game" },
+    { id: "3", name: "Alpine", category: "book" },
+    { id: "4", name: "Beta", category: "book" },
+  ];
+
+  for (const offset of [0, 1, 10]) {
+    assert.deepEqual(
+      listCatalog(records, { category: "book", query: "AL", offset, limit: 0 }),
+      { items: [], total: 2, nextOffset: null },
+    );
+  }
+});
+
+test("returned records are deep copies and inputs remain unchanged", () => {
+  const records = Object.freeze([
+    Object.freeze({
+      id: "1",
+      name: "Alpha",
+      category: "book",
+      details: Object.freeze({
+        tags: Object.freeze([Object.freeze({ label: "original" })]),
+      }),
+    }),
+  ]);
+  const original = structuredClone(records);
+  const result = listCatalog(records);
+
+  assert.deepEqual(result, { items: original, total: 1, nextOffset: null });
+  assert.notStrictEqual(result.items[0], records[0]);
+  assert.notStrictEqual(result.items[0].details, records[0].details);
+  assert.notStrictEqual(result.items[0].details.tags, records[0].details.tags);
+  assert.notStrictEqual(result.items[0].details.tags[0], records[0].details.tags[0]);
+
+  result.items[0].name = "Changed";
+  result.items[0].details.tags[0].label = "changed";
+  result.items[0].details.tags.push({ label: "new" });
+  result.items.push({ id: "2", name: "Extra", category: "game" });
+
+  assert.deepEqual(records, original);
+  assert.deepEqual(listCatalog(records).items, original);
+});
+
+for (const option of ["offset", "limit"]) {
+  test(`invalid ${option} values reject before reading records`, () => {
+    let reads = 0;
+    const records = [];
+    Object.defineProperty(records, 0, {
+      get() {
+        reads += 1;
+        return { id: "1", name: "Alpha", category: "book" };
+      },
+    });
+    Object.freeze(records);
+
+    for (const value of [null, -1, 0.5, NaN, Infinity, -Infinity, Number.MAX_SAFE_INTEGER + 1, "1", true, {}, []]) {
+      assert.throws(() => listCatalog(records, { [option]: value }));
+      assert.equal(reads, 0);
+    }
+  });
+}
+
+test("omitted and undefined pagination values retain their defaults", () => {
+  const records = Array.from({ length: 21 }, (_, index) => ({
+    id: String(index),
+    name: `Record ${index}`,
+    category: "book",
+  }));
+  const expected = { items: records.slice(0, 20), total: 21, nextOffset: 20 };
+
+  assert.deepEqual(listCatalog(records), expected);
+  assert.deepEqual(listCatalog(records, { offset: undefined, limit: undefined }), expected);
+  assert.deepEqual(listCatalog(records, { offset: 20 }), {
+    items: records.slice(20),
+    total: 21,
+    nextOffset: null,
+  });
+});
