diff --git a/test/public.test.mjs b/test/public.test.mjs
index eada690..ccc60b0 100644
--- a/test/public.test.mjs
+++ b/test/public.test.mjs
@@ -13,3 +13,60 @@ test("filters and pages", () => {
     nextOffset: 1,
   });
 });
+
+test("zero limit preserves the complete filtered total", () => {
+  const records = [
+    { id: "1", name: "Alpha", category: "book" },
+    { id: "2", name: "Alpine", category: "game" },
+    { id: "3", name: "Almanac", category: "book" },
+    { id: "4", name: "Beta", category: "book" },
+  ];
+  for (const offset of [0, 1, 10]) {
+    assert.deepEqual(
+      listCatalog(records, { category: "book", query: "AL", offset, limit: 0 }),
+      { items: [], total: 2, nextOffset: null },
+    );
+  }
+});
+
+test("returned records and nested values are independent of frozen inputs", () => {
+  const records = Object.freeze([
+    Object.freeze({
+      id: "1",
+      name: "Alpha",
+      category: "book",
+      details: Object.freeze({ tags: Object.freeze(["original"]) }),
+    }),
+  ]);
+  const options = Object.freeze({ category: "book", query: "AL", limit: 1 });
+  const result = listCatalog(records, options);
+  assert.deepEqual(result.items, records);
+  assert.notStrictEqual(result.items, records);
+  assert.notStrictEqual(result.items[0], records[0]);
+  assert.notStrictEqual(result.items[0].details, records[0].details);
+  assert.notStrictEqual(result.items[0].details.tags, records[0].details.tags);
+  result.items[0].name = "Changed";
+  result.items[0].details.tags.push("new");
+  result.items.push({ id: "2", name: "Beta", category: "book" });
+  assert.deepEqual(records, [
+    { id: "1", name: "Alpha", category: "book", details: { tags: ["original"] } },
+  ]);
+  assert.deepEqual(options, { category: "book", query: "AL", limit: 1 });
+});
+
+test("invalid pagination rejects before reading records", () => {
+  for (const key of ["offset", "limit"]) {
+    for (const value of [null, -1, 0.5, "1", NaN, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+      let reads = 0;
+      const records = [];
+      Object.defineProperty(records, 0, {
+        get() {
+          reads += 1;
+          return { id: "1", name: "Alpha", category: "book" };
+        },
+      });
+      assert.throws(() => listCatalog(records, { [key]: value }));
+      assert.equal(reads, 0);
+    }
+  }
+});
