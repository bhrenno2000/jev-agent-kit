+for (const [location, wrap] of [
+  ["directly", (payload) => payload],
+  ["inside objects", (payload) => ({ items: payload })],
+  ["inside arrays", (payload) => [payload]],
+]) {
+  test(`sparse arrays with extra properties reject ${location} without changing state`, async () => {
+    const system = createCheckout({ acme: { widget: 2 } });
+    const first = await system.checkout(request({ idempotencyKey: "existing" }));
+    const before = system.snapshot();
+    const payload = Array(1);
+    payload.extra = "not an indexed element";
+    await assert.rejects(system.checkout(request({ payload: wrap(payload) })), /invalid request/);
+    assert.deepEqual(system.snapshot(), before);
+    const validPayload = wrap([null]);
+    const result = await system.checkout(request({ payload: validPayload }));
+    assert.deepEqual(result.payload, validPayload);
+    assert.deepEqual(system.snapshot(), {
+      stock: { acme: { widget: 0 } },
+      orders: [first, result],
+    });
+  });
+}
+
+test("sparse arrays with extra properties do not consume a persistence failure", async () => {
+  const system = createCheckout({ acme: { widget: 1 } });
+  const before = system.snapshot();
+  const payload = Array(1);
+  payload.extra = "not an indexed element";
+  system.failNextPersistence();
+  await assert.rejects(system.checkout(request({ payload })), /invalid request/);
+  assert.deepEqual(system.snapshot(), before);
+  await assert.rejects(system.checkout(request({ payload: [null] })), /persistence failure/);
+  assert.deepEqual(system.snapshot(), before);
+  const result = await system.checkout(request({ payload: [null] }));
+  assert.deepEqual(system.snapshot(), { stock: { acme: { widget: 0 } }, orders: [result] });
+});
+
