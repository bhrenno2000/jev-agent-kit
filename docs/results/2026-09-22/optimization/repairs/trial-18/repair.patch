+for (const [location, wrap] of [
+  ["directly", (payload) => payload],
+  ["inside an object", (payload) => ({ items: payload })],
+  ["inside an array", (payload) => [payload]],
+]) {
+  test(`sparse arrays with extra properties reject ${location} without changing state or consuming persistence failure`, async () => {
+    const system = createCheckout({ acme: { widget: 3 } });
+    const first = await system.checkout(request());
+    const before = system.snapshot();
+    const payload = Array(1);
+    payload.extra = "not an indexed element";
+    const next = request({ idempotencyKey: "k2", payload: wrap(payload) });
+    await assert.rejects(system.checkout(next), /invalid request/);
+    assert.deepEqual(system.snapshot(), before);
+    system.failNextPersistence();
+    await assert.rejects(system.checkout(next), /invalid request/);
+    assert.deepEqual(system.snapshot(), before);
+    next.payload = wrap([null]);
+    await assert.rejects(system.checkout(next), /persistence failure/);
+    assert.deepEqual(system.snapshot(), before);
+    const second = await system.checkout(next);
+    assert.deepEqual(second.payload, wrap([null]));
+    assert.deepEqual(system.snapshot(), { stock: { acme: { widget: 1 } }, orders: [first, second] });
+  });
+}
