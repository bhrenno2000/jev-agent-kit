+test("sparse arrays with extra properties reject without changing stock or orders", async () => {
+  const system = createCheckout({ acme: { widget: 10 } });
+  await system.checkout(request());
+  const before = system.snapshot();
+  for (const sparse of [Array(1), [, "item"], ["first", , "last"], ["item", ,]]) {
+    sparse.extra = "not an indexed element";
+    assert.equal(Object.keys(sparse).length, sparse.length);
+    for (const payload of [sparse, { nested: sparse }, [sparse]]) {
+      await assert.rejects(
+        system.checkout(request({ idempotencyKey: "sparse", payload })),
+        /invalid request/,
+      );
+      assert.deepEqual(system.snapshot(), before);
+    }
+  }
+});
+
+test("invalid sparse payloads preserve the persistence flag and allow a valid retry", async () => {
+  const system = createCheckout({ acme: { widget: 1 } });
+  const before = system.snapshot();
+  const payload = Array(1);
+  payload.extra = "not an indexed element";
+  system.failNextPersistence();
+  await assert.rejects(system.checkout(request({ payload })), /invalid request/);
+  assert.deepEqual(system.snapshot(), before);
+  const valid = request({ payload: [null, [], ["item"]] });
+  await assert.rejects(system.checkout(valid), /persistence failure/);
+  assert.deepEqual(system.snapshot(), before);
+  const result = await system.checkout(valid);
+  assert.deepEqual(result.payload, valid.payload);
+  assert.deepEqual(await system.checkout(valid), result);
+  assert.deepEqual(system.snapshot(), {
+    stock: { acme: { widget: 0 } },
+    orders: [result],
+  });
+});
+
