+
+test("sparse arrays reject even when extra properties conceal missing elements", async () => {
+  const system = createCheckout({ acme: { widget: 2 }, empty: {} });
+  const first = await system.checkout(request());
+  const before = system.snapshot();
+  const next = request({ orderId: "o2", idempotencyKey: "k2" });
+  const payload = Array(1);
+  payload.extra = "not an indexed element";
+  const malformed = [
+    payload,
+    Array(1),
+    Object.assign([, "present"], { extra: "not an indexed element" }),
+    Object.assign(Array(1), { "01": "not an indexed element" }),
+    Object.assign([null], { extra: "not an indexed element" }),
+  ];
+  await assert.rejects(system.checkout({ ...next, payload }), /invalid request/);
+  assert.deepEqual(system.snapshot(), before);
+  system.failNextPersistence();
+  for (const array of malformed) {
+    for (const invalid of [array, { nested: [array] }]) {
+      await assert.rejects(system.checkout({ ...next, payload: invalid }), /invalid request/);
+      assert.deepEqual(system.snapshot(), before);
+    }
+  }
+  await assert.rejects(system.checkout(next), /persistence failure/);
+  assert.deepEqual(system.snapshot(), before);
+  const second = await system.checkout(next);
+  assert.deepEqual(system.snapshot(), {
+    stock: { acme: { widget: 0 }, empty: {} },
+    orders: [first, second],
+  });
+});
+
+test("dense arrays accept empty arrays and objects with prototype-like JSON keys", async () => {
+  const system = createCheckout({ acme: { widget: 2 } });
+  const payload = JSON.parse('[[],null,true,1,"value",{"__proto__":[],"constructor":{"toString":null}}]');
+  const reordered = JSON.parse('[[],null,true,1,"value",{"constructor":{"toString":null},"__proto__":[]}]');
+  const first = await system.checkout(request({ payload }));
+  assert.deepEqual(first.payload, payload);
+  assert.deepEqual(await system.checkout(request({ payload: reordered })), first);
+  assert.deepEqual(system.snapshot(), { stock: { acme: { widget: 1 } }, orders: [first] });
+});
