+test("a transport mutation cannot change caller data or prevent a later delivery", async () => {
+  const event = { id: "mutating-transport", type: "invoice.ready", payload: { items: [{ amount: 42 }] } };
+  const original = structuredClone(event);
+  const failures = createFailureStore();
+  const clock = createClock();
+  let calls = 0;
+  const transport = {
+    async send(snapshot) {
+      calls += 1;
+      assert.deepEqual(snapshot, original);
+      if (calls === 1) snapshot.payload.items[0].amount = 999;
+    },
+  };
+  const service = createDeliveryWorkflow({ transport, failures, clock });
+  const result = await service.deliver(event);
+
+  assert.equal(typeof result.error, "string");
+  assert.deepEqual(result, { eventId: event.id, status: "failed", attempts: 1, error: result.error });
+  assert.deepEqual(failures.all(), [result]);
+  assert.deepEqual(event, original);
+  assert.deepEqual(clock.waits(), []);
+  assert.deepEqual(await service.deliver(event), { eventId: event.id, status: "sent", attempts: 1 });
+  assert.equal((await service.deliver(event)).duplicate, true);
+  assert.equal(calls, 2);
+});
+
+test("failed results retain the error field when transports throw without a message", async (t) => {
+  for (const error of [undefined, null, "unavailable"]) {
+    await t.test(String(error), async () => {
+      const failures = createFailureStore();
+      const clock = createClock();
+      const transport = { async send() { throw error; } };
+      const service = createDeliveryWorkflow({ transport, failures, clock });
+      const expected = { eventId: "no-message", status: "failed", attempts: 1, error: undefined };
+
+      assert.deepEqual(await service.deliver({ id: "no-message", type: "invoice.ready" }), expected);
+      assert.deepEqual(failures.all(), [expected]);
+      assert.deepEqual(clock.waits(), []);
+    });
+  }
+});
