+test("unserializable outbox data cannot partially publish a persistence commit", async () => {
+  const store = createStore({ "tenant-a:widget": 2 });
+  const outbox = createOutbox();
+  const persistence = createPersistence(store, outbox, createFaults());
+  outbox.append({ type: "existing" });
+  const before = persistence.snapshot();
+  const draft = persistence.snapshot();
+  draft.stock["tenant-a:widget"] = 0;
+  await assert.rejects(persistence.commit(draft, [{ value: () => {} }]));
+  assert.deepEqual(persistence.snapshot(), before);
