+test("pending persistence exposes no writes and failure releases the lock for a competitor", async () => {
+  const store = createStore({ "tenant-a:widget": 1 });
+  const outbox = createOutbox();
+  const faults = createFaults();
+  const persistence = createPersistence(store, outbox, faults);
+  const commit = persistence.commit;
+  let enter;
+  let release;
+  const entered = new Promise((resolve) => { enter = resolve; });
+  const gate = new Promise((resolve) => { release = resolve; });
+  let first = true;
+  persistence.commit = async (...args) => {
+    if (first) {
+      first = false;
+      enter();
+      await gate;
+    }
+    return commit(...args);
+  };
+  const service = createInventoryService({ store, persistence, outbox, lock: createLock() });
+  const before = state(service);
+  faults.failNext("persist");
+  const pending = service.reserve(request());
+  await entered;
+  assert.deepEqual(state(service), before);
+  const competitor = service.reserve(request({ orderId: "order-b", idempotencyKey: "reserve-b" }));
+  await Promise.resolve();
+  assert.deepEqual(state(service), before);
+  const results = Promise.allSettled([pending, competitor]);
+  release();
+  const [failed, succeeded] = await results;
+  assert.equal(failed.status, "rejected");
+  assert.match(failed.reason.message, /persist failed/);
+  assert.equal(succeeded.status, "fulfilled");
+  assert.equal(succeeded.value.orderId, "order-b");
+  assert.equal(store.stock("tenant-a", "widget"), 0);
+  assert.equal(store.reservations.size, 1);
+  assert.equal(store.idempotency.size, 1);
+  assert.equal(service.events().length, 1);
+});
