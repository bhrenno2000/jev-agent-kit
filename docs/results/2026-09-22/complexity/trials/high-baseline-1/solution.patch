+test("outbox persistence failure leaves reservation and checkout state unchanged", async () => {
+  for (const operation of ["reserve", "checkout"]) {
+    const service = createInventorySystem({ "tenant-a:widget": 2 });
+    if (operation === "checkout") await service.reserve(request());
+    const input = request({ idempotencyKey: operation });
+    const before = state(service);
+    const replace = service.outbox.replace;
+    service.outbox.replace = () => { throw new Error("outbox failed"); };
+    await assert.rejects(service[operation](input), /outbox failed/);
+    assert.deepEqual(state(service), before);
+    service.outbox.replace = replace;
+    await service[operation](input);
+    assert.equal(service.events().length, operation === "reserve" ? 1 : 2);
+  }
+});
