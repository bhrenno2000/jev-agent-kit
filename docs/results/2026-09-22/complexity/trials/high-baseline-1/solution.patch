+  checkedOut.status = "changed";
+  checkedOut.tenantId = "changed";
+  const another = await service.checkout({ ...input, idempotencyKey: "checkout-b" });
+  another.quantity = 100;
+  const before = state(service);
+  const snapshot = service.snapshot();
+  snapshot.reservations["tenant-a:order-a"].status = "changed";
+  for (const record of Object.values(snapshot.idempotency)) record.result.quantity = 100;
+  snapshot.stock["tenant-a:widget"] = 100;
+  const events = service.events();
+  events[0].sku = "changed";
+  events[1].quantity = 100;
+  events.push({ type: "changed" });
+  const outboxEvents = service.outbox.all();
+  outboxEvents[0].tenantId = "changed";
+  assert.deepEqual(await service.reserve(request()), original);
+  assert.deepEqual(await service.checkout(input), expected);
+  assert.deepEqual(await service.checkout({ ...input, idempotencyKey: "checkout-b" }), expected);
+  assert.deepEqual(state(service), before);
+});
