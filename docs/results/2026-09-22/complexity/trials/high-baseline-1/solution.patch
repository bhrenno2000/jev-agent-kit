+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ConflictError, NotFoundError } from "../src/errors.mjs";
+import { createFaults } from "../src/faults.mjs";
+import { createInventorySystem } from "../src/index.mjs";
+import { createLock } from "../src/lock.mjs";
+import { createOutbox } from "../src/outbox.mjs";
+import { createPersistence } from "../src/persistence.mjs";
+import { createInventoryService } from "../src/service.mjs";
+import { createStore } from "../src/store.mjs";
+import { tenantKey } from "../src/tenant.mjs";
+
+function request(overrides = {}) {
+  return {
+    tenantId: "tenant-a",
+    orderId: "order-a",
+    sku: "widget",
+    quantity: 1,
+    idempotencyKey: "reserve-a",
+    ...overrides,
+  };
+}
+
+function state(service) {
+  return { snapshot: service.snapshot(), events: service.events() };
+}
+
+test("a reservation persists stock, reservation, idempotency, and one event", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 3 });
+  const result = await service.reserve(request({ quantity: 2 }));
+  const snapshot = service.snapshot();
+  assert.equal(snapshot.stock["tenant-a:widget"], 1);
+  assert.deepEqual(snapshot.reservations["tenant-a:order-a"], result);
+  assert.deepEqual(service.store.reservations.get("tenant-a:order-a"), result);
+  assert.equal(service.store.idempotency.size, 1);
+  assert.equal(result.status, "reserved");
+  assert.equal(typeof result.createdAt, "number");
+  assert.deepEqual(service.events(), [{
+    type: "inventory.reserved",
+    tenantId: "tenant-a",
+    orderId: "order-a",
+    sku: "widget",
+    quantity: 2,
+  }]);
+});
+
+test("concurrent exact retries reserve the last unit only once", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 1 });
+  const results = await Promise.all(Array.from({ length: 8 }, () => service.reserve(request())));
+  for (const result of results) assert.deepEqual(result, results[0]);
+  assert.notStrictEqual(results[0], results[1]);
+  assert.equal(service.snapshot().stock["tenant-a:widget"], 0);
+  assert.equal(service.store.reservations.size, 1);
+  assert.equal(service.store.idempotency.size, 1);
+  assert.equal(service.events().length, 1);
+});
+
+test("overlapping orders cannot oversell available inventory", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 3 });
+  const results = await Promise.allSettled(Array.from({ length: 8 }, (_, index) =>
+    service.reserve(request({ orderId: `order-${index}`, idempotencyKey: `key-${index}` })),
+  ));
+  assert.equal(results.filter((result) => result.status === "fulfilled").length, 3);
+  for (const result of results.filter((result) => result.status === "rejected")) {
+    assert.ok(result.reason instanceof ConflictError);
+  }
+  assert.equal(service.snapshot().stock["tenant-a:widget"], 0);
+  assert.equal(service.store.reservations.size, 3);
+  assert.equal(service.store.idempotency.size, 3);
+  assert.equal(service.events().length, 3);
+});
+
+test("tenants independently reuse order IDs and reserve and checkout keys", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 1, "tenant-b:widget": 2 });
+  const requests = [request(), request({ tenantId: "tenant-b", quantity: 2 })];
+  const reservations = await Promise.all(requests.map((input) => service.reserve(input)));
+  assert.equal(service.store.reservations.size, 2);
+  assert.deepEqual(service.snapshot().stock, { "tenant-a:widget": 0, "tenant-b:widget": 0 });
+  const checkouts = requests.map((input) => ({ ...input, idempotencyKey: "checkout" }));
+  const results = await Promise.all(checkouts.map((input) => service.checkout(input)));
+  assert.equal(service.events().length, 4);
+  const before = state(service);
+  for (let index = 0; index < requests.length; index += 1) {
+    assert.deepEqual(await service.reserve(requests[index]), reservations[index]);
+    assert.deepEqual(await service.checkout(checkouts[index]), results[index]);
+  }
+  assert.deepEqual(state(service), before);
+});
+
