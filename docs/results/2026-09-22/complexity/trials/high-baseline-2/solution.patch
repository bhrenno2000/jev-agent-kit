+  const completed = await system.checkout(request({ idempotencyKey: "checkout" }));
+  const before = state(system);
+  system.faults.failNext("persist");
+  const input = request({ idempotencyKey: "another" });
+  await assert.rejects(system.checkout(input), /persist failed/);
+  assert.deepEqual(state(system), before);
+  assert.deepEqual(await system.checkout(input), completed);
+  assert.equal(system.store.idempotency.size, 3);
+  assert.deepEqual(system.events(), before.events);
+});
+
+test("reservation, snapshot, retry, and event results do not share mutable state", async () => {
+  const system = createInventorySystem({ "tenant-a:widget": 5 });
+  const result = await system.reserve(request());
+  const original = structuredClone(result);
+  const before = state(system);
+  result.quantity = 99;
+  result.status = "changed";
+  result.sku = "changed";
+  const snapshot = system.snapshot();
+  snapshot.stock["tenant-a:widget"] = 99;
+  snapshot.reservations["tenant-a:order-a"].status = "changed";
+  Object.values(snapshot.idempotency)[0].result.quantity = 99;
+  const events = system.events();
+  events[0].quantity = 99;
+  events.push({ type: "changed" });
+  system.outbox.all()[0].sku = "changed";
+  assert.deepEqual(state(system), before);
+  const retry = await system.reserve(request());
+  assert.deepEqual(retry, original);
+  retry.orderId = "changed";
+  assert.deepEqual(await system.reserve(request()), original);
+  const checkoutInput = request({ idempotencyKey: "checkout" });
+  const completed = await system.checkout(checkoutInput);
+  const expected = { ...original, status: "checked_out" };
+  assert.deepEqual(completed, expected);
+  completed.status = "changed";
+  completed.quantity = 99;
+  assert.deepEqual(await system.checkout(checkoutInput), expected);
+  const anotherInput = request({ idempotencyKey: "another" });
+  const another = await system.checkout(anotherInput);
+  another.quantity = 99;
+  another.status = "changed";
+  assert.deepEqual(await system.checkout(anotherInput), expected);
+  assert.deepEqual(await system.reserve(request()), original);
+  assert.deepEqual(system.snapshot().reservations["tenant-a:order-a"], expected);
+  assert.equal(before.snapshot.reservations["tenant-a:order-a"].status, "reserved");
+  assert.deepEqual(system.events().map((event) => event.quantity), [1, 1]);
+});
+
+for (const operation of ["reserve", "checkout"]) {
+  test(`${operation} remains invisible until persistence commits`, async () => {
+    const system = createInventorySystem({ "tenant-a:widget": 2 });
+    if (operation === "checkout") await system.reserve(request());
+    const persistence = createPersistence(system.store, system.outbox, system.faults);
+    const reached = deferred();
+    const release = deferred();
+    const service = createInventoryService({
+      store: system.store,
+      outbox: system.outbox,
+      lock: createLock(),
+      persistence: {
+        ...persistence,
+        async commit(snapshot, events) {
+          reached.resolve();
+          await release.promise;
+          await persistence.commit(snapshot, events);
+        },
+      },
+    });
+    const before = state(system);
+    const pending = service[operation](request({ idempotencyKey: operation }));
+    await reached.promise;
+    try {
+      assert.deepEqual(state(system), before);
+      assert.deepEqual(system.store.snapshot(), before.snapshot);
+    } finally {
+      release.resolve();
+    }
+    const result = await pending;
+    assert.equal(result.status, operation === "reserve" ? "reserved" : "checked_out");
+    assert.equal(system.events().length, before.events.length + 1);
+  });
+}
