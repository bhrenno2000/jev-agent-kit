+test("outbox serialization failure leaves inventory and records unchanged", async () => {
+  const system = createInventorySystem({ "tenant-a:widget": 2 });
+  await system.reserve(request());
+  const before = state(system);
+  const persistence = createPersistence(system.store, system.outbox, system.faults);
+  const next = system.snapshot();
+  next.stock["tenant-a:widget"] = 0;
+  next.reservations["tenant-a:order-a"].status = "checked_out";
+  await assert.rejects(persistence.commit(next, [...system.events(), { invalid: () => {} }]));
+  assert.deepEqual(state(system), before);
+});
