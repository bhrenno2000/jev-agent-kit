+  const completed = await Promise.all(checkoutInputs.map((input) => system.checkout(input)));
+  for (const [index, input] of checkoutInputs.entries()) {
+    assert.deepEqual(completed[index], { ...reserved[index], status: "checked_out" });
+    assert.deepEqual(await system.checkout(input), completed[index]);
+  }
+  assert.equal(system.store.reservations.size, 3);
+  assert.equal(system.store.idempotency.size, 6);
+  assert.equal(system.events().length, 6);
+});
+
+test("reserve idempotency rejects changed order, SKU, quantity, or operation", async () => {
