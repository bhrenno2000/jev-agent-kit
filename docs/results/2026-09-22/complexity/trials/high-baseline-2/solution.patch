+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ConflictError, NotFoundError } from "../src/errors.mjs";
+import { createInventorySystem } from "../src/index.mjs";
+import { createLock } from "../src/lock.mjs";
+import { createPersistence } from "../src/persistence.mjs";
+import { createInventoryService } from "../src/service.mjs";
+
+function request(overrides = {}) {
+  return {
+    tenantId: "tenant-a",
+    orderId: "order-a",
+    sku: "widget",
+    quantity: 1,
+    idempotencyKey: "reserve-a",
+    ...overrides,
+  };
+}
+
+function state(system) {
+  return { snapshot: system.snapshot(), events: system.events() };
+}
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((complete) => {
+    resolve = complete;
+  });
+  return { promise, resolve };
+}
+
+test("overlapping reservations consume only available units and persist every winner", async () => {
+  const system = createInventorySystem({ "tenant-a:widget": 3 });
+  const results = await Promise.allSettled(
+    Array.from({ length: 10 }, (_, index) =>
+      system.reserve(request({ orderId: `order-${index}`, idempotencyKey: `reserve-${index}` })),
+    ),
+  );
+  const winners = results.filter((result) => result.status === "fulfilled");
+  const losers = results.filter((result) => result.status === "rejected");
+  assert.equal(winners.length, 3);
+  assert.equal(losers.length, 7);
+  for (const result of losers) assert.ok(result.reason instanceof ConflictError);
+  const snapshot = system.snapshot();
+  assert.equal(snapshot.stock["tenant-a:widget"], 0);
+  assert.equal(Object.keys(snapshot.reservations).length, 3);
+  assert.equal(Object.keys(snapshot.idempotency).length, 3);
+  assert.equal(system.events().length, 3);
+  assert.equal(system.store.reservations.size, 3);
+  assert.equal(system.store.idempotency.size, 3);
+  for (const { value } of winners) {
+    assert.deepEqual(snapshot.reservations[`tenant-a:${value.orderId}`], value);
+    assert.ok(system.events().some((event) => event.orderId === value.orderId));
+  }
+});
+
+test("concurrent exact reserve retries return the original result and leave the request unchanged", async () => {
+  const system = createInventorySystem({ "tenant-a:widget": 2 });
+  const input = Object.freeze(request());
+  const results = await Promise.all(Array.from({ length: 8 }, () => system.reserve(input)));
+  for (const result of results) assert.deepEqual(result, results[0]);
+  assert.notStrictEqual(results[0], results[1]);
+  assert.deepEqual(input, request());
+  assert.equal(system.store.stock("tenant-a", "widget"), 1);
+  assert.equal(system.events().length, 1);
+  assert.equal(system.store.idempotency.size, 1);
+  const before = state(system);
+  assert.deepEqual(await system.reserve(input), results[0]);
+  assert.deepEqual(state(system), before);
+});
+
+test("tenants can reserve and check out the same order with the same idempotency keys", async () => {
+  const system = createInventorySystem({ "tenant-a:widget": 1, "tenant-b:widget": 2 });
+  const inputs = [request(), request({ tenantId: "tenant-b" })];
+  const reservations = await Promise.all(inputs.map((input) => system.reserve(input)));
+  assert.equal(system.store.stock("tenant-a", "widget"), 0);
+  assert.equal(system.store.stock("tenant-b", "widget"), 1);
+  assert.equal(system.store.reservations.size, 2);
+  const checkoutInputs = inputs.map((input) => ({ ...input, idempotencyKey: "checkout" }));
+  const completed = await Promise.all(checkoutInputs.map((input) => system.checkout(input)));
+  assert.deepEqual(completed.map((result) => result.tenantId), ["tenant-a", "tenant-b"]);
+  assert.ok(completed.every((result) => result.status === "checked_out"));
+  const before = state(system);
+  assert.deepEqual(await Promise.all(inputs.map((input) => system.reserve(input))), reservations);
+  assert.deepEqual(await Promise.all(checkoutInputs.map((input) => system.checkout(input))), completed);
+  assert.deepEqual(state(system), before);
+  assert.equal(system.store.idempotency.size, 4);
+  assert.equal(system.events().length, 4);
+});
+
+test("tenant identifiers containing delimiters cannot alias another tenant's keys", async () => {
+  const system = createInventorySystem();
+  const inputs = [
+    request({ tenantId: "tenant:a", orderId: "order", sku: "widget", idempotencyKey: "reserve" }),
+    request({ tenantId: "tenant", orderId: "a:order", sku: "a:widget", idempotencyKey: "a:reserve" }),
+    request({ tenantId: "tenant%3Aa", orderId: "order", sku: "widget", idempotencyKey: "reserve" }),
+  ];
+  for (const [index, input] of inputs.entries()) {
+    system.store.setStock(input.tenantId, input.sku, index + 1);
+  }
+  const reserved = await Promise.all(inputs.map((input) => system.reserve(input)));
+  for (const [index, input] of inputs.entries()) {
+    assert.equal(system.store.stock(input.tenantId, input.sku), index);
+    assert.deepEqual(await system.reserve(input), reserved[index]);
+  }
+  const checkoutInputs = inputs.map((input) => ({
+    ...input,
+    idempotencyKey: input.idempotencyKey.replace("reserve", "checkout"),
