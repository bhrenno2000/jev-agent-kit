+test("requests are captured before waiting and frozen requests are accepted", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 2 });
+  const command = request();
+  const reserved = service.reserve(command);
+  command.idempotencyKey = "checkout";
+  const completed = service.checkout(command);
+  command.sku = "changed";
+  command.quantity = 100;
+  assert.equal((await reserved).sku, "widget");
+  assert.equal((await completed).status, "checked_out");
+  assert.equal(Object.hasOwn(command, "operation"), false);
+  const frozen = Object.freeze(request({ orderId: "order-b", idempotencyKey: "reserve-b" }));
+  assert.equal((await service.reserve(frozen)).status, "reserved");
+  const frozenCheckout = Object.freeze({ ...frozen, idempotencyKey: "checkout-b" });
+  assert.equal((await service.checkout(frozenCheckout)).status, "checked_out");
+});
+
+test("pending reserve persistence exposes only committed state and serializes competitors", async () => {
+  const service = controlledSystem({ "tenant-a:widget": 1 });
+  const before = state(service);
+  const gate = service.pauseCommit();
+  const first = service.reserve(request());
+  await gate.entered.promise;
+  const second = service.reserve(request({ orderId: "order-b", idempotencyKey: "reserve-b" }));
+  const results = Promise.allSettled([first, second]);
+  try {
+    assert.deepEqual(state(service), before);
+    assert.deepEqual(service.store.snapshot(), before.snapshot);
+  } finally {
+    gate.release.resolve();
+  }
+  assert.deepEqual((await results).map((result) => result.status), ["fulfilled", "rejected"]);
+  assert.equal(service.snapshot().stock["tenant-a:widget"], 0);
+  assert.equal(service.events().length, 1);
+});
+
+test("pending checkout persistence exposes no status, idempotency, or outbox changes", async () => {
+  const service = controlledSystem({ "tenant-a:widget": 1 });
+  await service.reserve(request());
+  const before = state(service);
+  const gate = service.pauseCommit();
+  const pending = service.checkout(request({ idempotencyKey: "checkout" }));
+  await gate.entered.promise;
+  const rejected = assert.rejects(pending, /persist failed/);
+  try {
+    assert.deepEqual(state(service), before);
+    assert.deepEqual(service.store.snapshot(), before.snapshot);
+    service.faults.failNext("persist");
+  } finally {
+    gate.release.resolve();
+  }
+  await rejected;
+  assert.deepEqual(state(service), before);
+  assert.equal((await service.checkout(request({ idempotencyKey: "checkout" }))).status, "checked_out");
+  assert.equal(service.events().length, 2);
+});
