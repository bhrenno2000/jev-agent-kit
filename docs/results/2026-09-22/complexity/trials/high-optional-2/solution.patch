+  snapshot.reservations["tenant-a:order-a"].quantity = 100;
+  Object.values(snapshot.idempotency)[0].result.status = "changed";
+  Object.values(snapshot.idempotency)[0].fingerprint = "changed";
+  const events = service.events();
+  events[0].quantity = 100;
+  events.push({ type: "changed" });
+  const outboxEvents = service.outbox.all();
+  outboxEvents[0].sku = "changed";
+  outboxEvents.length = 0;
+  assert.deepEqual(state(service), before);
+
+  const stable = await service.reserve(request());
+  const checkout = request({ idempotencyKey: "checkout" });
+  const completed = await service.checkout(checkout);
+  const originalCompletion = structuredClone(completed);
+  assert.equal(stable.status, "reserved");
+  assert.deepEqual(await service.reserve(request()), original);
+  completed.quantity = 100;
+  completed.status = "changed";
+  assert.deepEqual(await service.checkout(checkout), originalCompletion);
+  const secondKey = request({ idempotencyKey: "second-checkout" });
+  const alreadyCompleted = await service.checkout(secondKey);
+  assert.deepEqual(alreadyCompleted, originalCompletion);
+  alreadyCompleted.sku = "changed";
+  assert.deepEqual(await service.checkout(secondKey), originalCompletion);
+  assert.deepEqual(service.snapshot().reservations["tenant-a:order-a"], originalCompletion);
+  assert.deepEqual(service.events().map((event) => event.quantity), [1, 1]);
+});
