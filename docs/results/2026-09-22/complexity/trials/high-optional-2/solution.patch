+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ConflictError, NotFoundError } from "../src/errors.mjs";
+import { createFaults } from "../src/faults.mjs";
+import { createInventorySystem } from "../src/index.mjs";
+import { createLock } from "../src/lock.mjs";
+import { createOutbox } from "../src/outbox.mjs";
+import { createPersistence } from "../src/persistence.mjs";
+import { createInventoryService } from "../src/service.mjs";
+import { createStore } from "../src/store.mjs";
+
+function request(overrides = {}) {
+  return {
+    tenantId: "tenant-a",
+    orderId: "order-a",
+    sku: "widget",
+    quantity: 1,
+    idempotencyKey: "reserve-a",
+    ...overrides,
+  };
+}
+
+function state(service) {
+  return { snapshot: service.snapshot(), events: service.events() };
+}
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+function controlledSystem(initial) {
+  const store = createStore(initial);
+  const outbox = createOutbox();
+  const faults = createFaults();
+  const persistence = createPersistence(store, outbox, faults);
+  let gate;
+  const service = createInventoryService({
+    store,
+    outbox,
+    lock: createLock(),
+    persistence: {
+      ...persistence,
+      async commit(snapshot, events) {
+        if (gate) {
+          const pending = gate;
+          gate = undefined;
+          pending.entered.resolve();
+          await pending.release.promise;
+        }
+        await persistence.commit(snapshot, events);
+      },
+    },
+  });
+  return {
+    ...service,
+    store,
+    faults,
+    pauseCommit() {
+      gate = { entered: deferred(), release: deferred() };
+      return gate;
+    },
+  };
+}
+
+test("overlapping reservations cannot oversell or lose committed events", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 4 });
+  const results = await Promise.allSettled(
+    Array.from({ length: 12 }, (_, index) =>
+      service.reserve(request({ orderId: `order-${index}`, idempotencyKey: `key-${index}` })),
+    ),
+  );
+  assert.equal(results.filter((result) => result.status === "fulfilled").length, 4);
+  const rejected = results.filter((result) => result.status === "rejected");
+  assert.equal(rejected.length, 8);
+  assert.ok(rejected.every((result) => result.reason instanceof ConflictError));
+  const snapshot = service.snapshot();
+  assert.equal(snapshot.stock["tenant-a:widget"], 0);
+  assert.equal(Object.keys(snapshot.reservations).length, 4);
+  assert.equal(Object.keys(snapshot.idempotency).length, 4);
+  assert.equal(service.store.reservations.size, 4);
+  assert.equal(service.store.idempotency.size, 4);
+  assert.deepEqual(service.store.snapshot(), snapshot);
+  assert.equal(service.events().length, 4);
+  assert.equal(new Set(service.events().map((event) => event.orderId)).size, 4);
+});
+
+test("concurrent exact reservation retries share one mutation and event", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 1 });
+  const results = await Promise.all(Array.from({ length: 6 }, () => service.reserve(request())));
+  for (const result of results) assert.deepEqual(result, results[0]);
+  assert.notStrictEqual(results[0], results[1]);
+  assert.equal(service.snapshot().stock["tenant-a:widget"], 0);
+  assert.equal(Object.keys(service.snapshot().idempotency).length, 1);
+  assert.equal(service.events().length, 1);
+});
+
+test("idempotency rejects changes to order, SKU, quantity, or operation", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 5, "tenant-a:gadget": 5 });
+  await service.reserve(request());
+  const before = state(service);
+  for (const change of [{ orderId: "order-b" }, { sku: "gadget" }, { quantity: 2 }]) {
+    await assert.rejects(service.reserve(request(change)), ConflictError);
+    assert.deepEqual(state(service), before);
+  }
+  await assert.rejects(service.checkout(request()), ConflictError);
+  assert.deepEqual(state(service), before);
+});
+
+test("concurrent requests with conflicting idempotency arguments have one winner", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 2 });
+  const results = await Promise.allSettled([
+    service.reserve(request()),
+    service.reserve(request({ orderId: "order-b" })),
+  ]);
+  assert.equal(results[0].status, "fulfilled");
+  assert.equal(results[1].status, "rejected");
+  assert.ok(results[1].reason instanceof ConflictError);
+  assert.equal(service.snapshot().stock["tenant-a:widget"], 1);
+  assert.equal(Object.keys(service.snapshot().reservations).length, 1);
+  assert.equal(service.events().length, 1);
+});
+
+test("tenants independently reuse order and idempotency keys for reserve and checkout", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 2, "tenant-b:widget": 3 });
+  const requests = [request(), request({ tenantId: "tenant-b", quantity: 2 })];
+  const reservations = await Promise.all(requests.map((value) => service.reserve(value)));
+  assert.deepEqual(reservations.map((value) => value.quantity), [1, 2]);
+  const completed = await Promise.all(
+    requests.map((value) => service.checkout({ ...value, idempotencyKey: "checkout" })),
+  );
+  assert.deepEqual(completed.map((value) => value.tenantId), ["tenant-a", "tenant-b"]);
+  assert.ok(completed.every((value) => value.status === "checked_out"));
+  assert.deepEqual(service.snapshot().stock, { "tenant-a:widget": 1, "tenant-b:widget": 1 });
+  assert.equal(Object.keys(service.snapshot().reservations).length, 2);
+  assert.equal(Object.keys(service.snapshot().idempotency).length, 4);
+  assert.equal(service.events().length, 4);
+  const before = state(service);
+  assert.deepEqual(await service.reserve(requests[0]), reservations[0]);
+  assert.deepEqual(await service.reserve(requests[1]), reservations[1]);
+  for (let index = 0; index < requests.length; index++) {
+    assert.deepEqual(
+      await service.checkout({ ...requests[index], idempotencyKey: "checkout" }),
+      completed[index],
+    );
+  }
+  assert.deepEqual(state(service), before);
+});
+
+test("an existing order rejects a new reservation key before and after checkout", async () => {
