+
+test("succeeds when the cursor chain ends exactly at the page limit", async () => {
+  const api = createCatalogApi();
+  assert.deepEqual(await fetchAllPages(api, { maxPages: 3 }), ["alpha", "beta", "gamma", "delta", "epsilon"]);
+  assert.deepEqual(api.calls(), [undefined, "cursor-2", "cursor-3"]);
+});
+
+test("preserves item order and responses while following cursors through empty pages", async () => {
+  const pages = new Map([
+    [undefined, Object.freeze({ items: Object.freeze(["beta", "alpha"]), nextCursor: "empty-page" })],
+    ["empty-page", Object.freeze({ items: Object.freeze([]), nextCursor: "last-page" })],
+    ["last-page", Object.freeze({ items: Object.freeze(["gamma", "alpha"]), nextCursor: undefined })],
+  ]);
+  const calls = [];
+  const api = {
+    async fetchPage(cursor) {
+      calls.push(cursor);
+      assert.ok(pages.has(cursor));
+      return pages.get(cursor);
+    },
+  };
+
+  const items = await fetchAllPages(api);
+  assert.deepEqual(items, ["beta", "alpha", "gamma", "alpha"]);
+  assert.deepEqual(calls, [undefined, "empty-page", "last-page"]);
+  assert.notStrictEqual(items, pages.get(undefined).items);
+});
+
+for (const nextCursor of [undefined, null, ""]) {
+  test(`stops after an empty terminal page with cursor ${String(nextCursor)}`, async () => {
+    const calls = [];
+    const api = {
+      async fetchPage(cursor) {
+        calls.push(cursor);
+        return { items: [], nextCursor };
+      },
+    };
+
+    assert.deepEqual(await fetchAllPages(api), []);
+    assert.deepEqual(calls, [undefined]);
+  });
+}
+
+test("does not fetch any pages when the page limit is zero", async () => {
