+
+test("enforces the default limit for a cursor chain that never ends", async () => {
+  const calls = [];
+  const api = {
+    async fetchPage(cursor) {
+      calls.push(cursor);
+      return { items: [], nextCursor: "repeat" };
+    },
+  };
+  await assert.rejects(fetchAllPages(api), /page limit/);
+  assert.deepEqual(calls, [undefined, ...Array(19).fill("repeat")]);
+});
+
+test("preserves item order through empty pages without mutating responses", async () => {
+  const pages = new Map([
+    [undefined, Object.freeze({ items: Object.freeze(["zeta", "alpha"]), nextCursor: "empty" })],
+    ["empty", Object.freeze({ items: Object.freeze([]), nextCursor: "last" })],
+    ["last", Object.freeze({ items: Object.freeze(["alpha", "beta"]), nextCursor: undefined })],
+  ]);
+  const calls = [];
+  const api = {
+    async fetchPage(cursor) {
+      calls.push(cursor);
+      assert.ok(pages.has(cursor));
+      return pages.get(cursor);
+    },
+  };
+  const items = await fetchAllPages(api);
+  assert.deepEqual(items, ["zeta", "alpha", "alpha", "beta"]);
+  assert.deepEqual(calls, [undefined, "empty", "last"]);
+  assert.notStrictEqual(items, pages.get(undefined).items);
+});
