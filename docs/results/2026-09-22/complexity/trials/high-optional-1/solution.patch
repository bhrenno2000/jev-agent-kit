+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ConflictError, NotFoundError } from "../src/errors.mjs";
+import { createFaults } from "../src/faults.mjs";
+import { createInventorySystem } from "../src/index.mjs";
+import { createLock } from "../src/lock.mjs";
+import { createOutbox } from "../src/outbox.mjs";
+import { createPersistence } from "../src/persistence.mjs";
+import { createInventoryService } from "../src/service.mjs";
+import { createStore } from "../src/store.mjs";
+
+function request(overrides = {}) {
+  return {
+    tenantId: "tenant-a",
+    orderId: "order-a",
+    sku: "widget",
+    quantity: 1,
+    idempotencyKey: "reserve-a",
+    ...overrides,
+  };
+}
+
+function checkoutRequest(overrides = {}) {
+  return request({ idempotencyKey: "checkout-a", ...overrides });
+}
+
+function state(service) {
+  return { snapshot: service.snapshot(), events: service.events() };
+}
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((complete) => {
+    resolve = complete;
+  });
+  return { promise, resolve };
+}
+
+test("overlapping reservations consume only available stock", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 5 });
+  const results = await Promise.allSettled(
+    Array.from({ length: 12 }, (_, index) =>
+      service.reserve(request({ orderId: `order-${index}`, idempotencyKey: `reserve-${index}` })),
+    ),
+  );
+  assert.equal(results.filter((result) => result.status === "fulfilled").length, 5);
+  for (const result of results.filter((result) => result.status === "rejected")) {
+    assert.ok(result.reason instanceof ConflictError);
+  }
+  const snapshot = service.snapshot();
+  assert.equal(snapshot.stock["tenant-a:widget"], 0);
+  assert.equal(Object.keys(snapshot.reservations).length, 5);
+  assert.equal(Object.keys(snapshot.idempotency).length, 5);
+  assert.equal(service.events().length, 5);
+});
+
+test("concurrent exact reserve retries return one original reservation", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 1 });
+  const results = await Promise.all(Array.from({ length: 8 }, () => service.reserve(request())));
+  for (const result of results) assert.deepEqual(result, results[0]);
+  assert.notStrictEqual(results[0], results[1]);
+  assert.equal(service.snapshot().stock["tenant-a:widget"], 0);
+  assert.equal(Object.keys(service.snapshot().reservations).length, 1);
+  assert.equal(Object.keys(service.snapshot().idempotency).length, 1);
+  assert.equal(service.events().length, 1);
+});
+
+test("stock, orders, and idempotency keys are isolated by tenant", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 1, "tenant-b:widget": 2 });
+  const requests = [request(), request({ tenantId: "tenant-b", quantity: 2 })];
+  const reservations = await Promise.all(requests.map((input) => service.reserve(input)));
+  const checkouts = await Promise.all(
+    requests.map((input) => service.checkout({ ...input, idempotencyKey: "checkout-a" })),
+  );
+  for (let index = 0; index < requests.length; index++) {
+    assert.equal(reservations[index].tenantId, requests[index].tenantId);
+    assert.equal(checkouts[index].quantity, requests[index].quantity);
+    assert.deepEqual(await service.reserve(requests[index]), reservations[index]);
+    assert.deepEqual(
+      await service.checkout({ ...requests[index], idempotencyKey: "checkout-a" }),
+      checkouts[index],
+    );
+  }
+  assert.deepEqual(service.snapshot().stock, { "tenant-a:widget": 0, "tenant-b:widget": 0 });
+  assert.equal(Object.keys(service.snapshot().reservations).length, 2);
+  assert.equal(Object.keys(service.snapshot().idempotency).length, 4);
+  assert.equal(service.events().length, 4);
+});
+
+test("one tenant cannot reserve another tenant's stock", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 2 });
+  const before = state(service);
+  await assert.rejects(service.reserve(request({ tenantId: "tenant-b" })), ConflictError);
+  assert.deepEqual(state(service), before);
+});
+
+test("an order can only be reserved again through an exact retry", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 3 });
+  const input = request();
+  const original = await service.reserve(input);
+  const before = state(service);
+  await assert.rejects(service.reserve(request({ idempotencyKey: "reserve-b" })), ConflictError);
+  assert.deepEqual(state(service), before);
+  await service.checkout(checkoutRequest());
