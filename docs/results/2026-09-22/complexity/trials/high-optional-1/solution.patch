+  assert.deepEqual(state(service), checkedOut);
+  assert.equal(original.status, "reserved");
+});
+
+test("concurrent requests with different keys cannot reserve the same order twice", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 2 });
+  const results = await Promise.allSettled([
