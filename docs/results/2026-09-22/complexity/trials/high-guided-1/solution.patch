+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ConflictError, NotFoundError } from "../src/errors.mjs";
+import { createInventorySystem } from "../src/index.mjs";
+import { createLock } from "../src/lock.mjs";
+import { createPersistence } from "../src/persistence.mjs";
+import { createInventoryService } from "../src/service.mjs";
+
+function request(overrides = {}) {
+  return {
+    tenantId: "tenant-a",
+    orderId: "order-a",
+    sku: "widget",
+    quantity: 1,
+    idempotencyKey: "reserve-a",
+    ...overrides,
+  };
+}
+
+function state(service) {
+  return { snapshot: service.snapshot(), events: service.events() };
+}
+
+function deferred() {
+  let resolve;
+  const promise = new Promise((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+test("overlapping reservations commit exactly the available stock", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 3 });
+  const results = await Promise.allSettled(
+    Array.from({ length: 10 }, (_, index) =>
+      service.reserve(request({ orderId: `order-${index}`, idempotencyKey: `key-${index}` })),
+    ),
+  );
+  assert.equal(results.filter((result) => result.status === "fulfilled").length, 3);
+  assert.equal(results.filter((result) => result.status === "rejected").length, 7);
+  for (const result of results.filter((result) => result.status === "rejected")) {
+    assert.ok(result.reason instanceof ConflictError);
+  }
+  assert.equal(service.snapshot().stock["tenant-a:widget"], 0);
+  assert.equal(service.store.stock("tenant-a", "widget"), 0);
+  assert.equal(service.store.reservations.size, 3);
+  assert.equal(service.store.idempotency.size, 3);
+  assert.equal(service.events().length, 3);
+  assert.deepEqual(service.store.snapshot(), service.snapshot());
+});
+
+test("tenants can share SKU, order, and idempotency keys independently", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 1, "tenant-b:widget": 2 });
+  await Promise.all([
+    service.reserve(request()),
+    service.reserve(request({ tenantId: "tenant-b", quantity: 2 })),
+  ]);
+  const results = await Promise.all([
+    service.checkout(request({ idempotencyKey: "checkout" })),
+    service.checkout(request({ tenantId: "tenant-b", quantity: 2, idempotencyKey: "checkout" })),
+  ]);
+  assert.deepEqual(results.map((result) => result.tenantId), ["tenant-a", "tenant-b"]);
+  assert.deepEqual(service.snapshot().stock, { "tenant-a:widget": 0, "tenant-b:widget": 0 });
+  assert.equal(service.store.reservations.size, 2);
+  assert.equal(service.store.idempotency.size, 4);
+  assert.equal(service.events().length, 4);
+  await assert.rejects(
+    service.reserve(request({ tenantId: "tenant-c" })),
+    ConflictError,
+  );
+});
+
+test("concurrent exact reservation retries return one original result", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 1 });
+  const results = await Promise.all(Array.from({ length: 8 }, () => service.reserve(request())));
+  for (const result of results) assert.deepEqual(result, results[0]);
+  assert.notStrictEqual(results[0], results[1]);
+  assert.equal(service.store.stock("tenant-a", "widget"), 0);
+  assert.equal(service.store.reservations.size, 1);
+  assert.equal(service.store.idempotency.size, 1);
+  assert.equal(service.events().length, 1);
+});
+
+test("reservation keys reject changed arguments and operation", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 4, "tenant-a:gadget": 4 });
+  await service.reserve(request());
+  const before = state(service);
+  for (const change of [{ orderId: "other" }, { sku: "gadget" }, { quantity: 2 }]) {
+    await assert.rejects(service.reserve(request(change)), ConflictError);
+    assert.deepEqual(state(service), before);
+  }
+  await assert.rejects(service.checkout(request()), ConflictError);
+  assert.deepEqual(state(service), before);
+});
+
+test("overlapping conflicting idempotency keys have one winner", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 2 });
+  const results = await Promise.allSettled([
+    service.reserve(request()),
+    service.reserve(request({ orderId: "other" })),
+  ]);
+  assert.equal(results[0].status, "fulfilled");
+  assert.equal(results[1].status, "rejected");
+  assert.ok(results[1].reason instanceof ConflictError);
+  assert.equal(service.store.stock("tenant-a", "widget"), 1);
+  assert.equal(service.store.idempotency.size, 1);
+  assert.equal(service.events().length, 1);
+});
+
+test("an existing order rejects new reservation keys before and after checkout", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 5, "tenant-a:gadget": 5 });
+  const original = await service.reserve(request());
+  for (const checkedOut of [false, true]) {
+    if (checkedOut) await service.checkout(request({ idempotencyKey: "checkout" }));
+    const before = state(service);
+    for (const change of [{}, { sku: "gadget" }, { quantity: 2 }]) {
+      await assert.rejects(
+        service.reserve(request({ ...change, idempotencyKey: "duplicate" })),
+        ConflictError,
+      );
+      assert.deepEqual(state(service), before);
+    }
+    assert.deepEqual(await service.reserve(request()), original);
+    assert.deepEqual(state(service), before);
+  }
+});
+
+test("overlapping new reservation keys cannot overwrite the same order", async () => {
+  const service = createInventorySystem({ "tenant-a:widget": 2 });
+  const results = await Promise.allSettled([
+    service.reserve(request()),
+    service.reserve(request({ idempotencyKey: "duplicate" })),
