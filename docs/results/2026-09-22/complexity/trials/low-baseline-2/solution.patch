+test("preserves item order and identity without mutating responses", async () => {
+  const first = Object.freeze({ id: "first" });
+  const second = Object.freeze({ id: "second" });
+  const firstPage = Object.freeze({
+    items: Object.freeze([second, first]),
+    nextCursor: "cursor-2",
+  });
+  const lastPage = Object.freeze({
+    items: Object.freeze([second]),
+    nextCursor: undefined,
+  });
+  const api = {
+    async fetchPage(cursor) {
