+test("transports receive a deeply frozen snapshot without changing caller data", async () => {
+  const event = {
+    id: "immutable", type: "invoice.ready",
+    payload: { items: [{ amount: 10n }], optional: undefined, date: new Date("2026-01-01T00:00:00Z") },
+  };
+  event.payload.self = event.payload;
+  const original = structuredClone(event);
+  const transport = {
+    async send(snapshot) {
+      assert.notEqual(snapshot, event);
+      assert.notEqual(snapshot.payload, event.payload);
+      assert.notEqual(snapshot.payload.items, event.payload.items);
+      assert.deepEqual(snapshot, original);
+      assert.equal(snapshot.payload.self, snapshot.payload);
+      for (const value of [snapshot, snapshot.payload, snapshot.payload.items, snapshot.payload.items[0]]) {
+        assert.equal(Object.isFrozen(value), true);
+      }
+      assert.throws(() => { snapshot.id = "changed"; }, TypeError);
+      assert.throws(() => { snapshot.payload.items[0].amount = 0n; }, TypeError);
+      assert.throws(() => { snapshot.payload.items.push({ amount: 0n }); }, TypeError);
+      assert.throws(() => { delete snapshot.payload.optional; }, TypeError);
+    },
+  };
+  const failures = createFailureStore();
+  const service = createDeliveryWorkflow({ transport, failures, clock: createClock() });
+
+  assert.equal((await service.deliver(event)).status, "sent");
+  assert.deepEqual(event, original);
+  assert.equal(Object.isFrozen(event), false);
+  assert.equal(Object.isFrozen(event.payload), false);
+  assert.deepEqual(failures.all(), []);
+});
