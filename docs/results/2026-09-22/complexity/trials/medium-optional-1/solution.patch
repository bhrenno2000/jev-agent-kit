+test("delivery waits for asynchronous failure persistence", async () => {
+  let finishSave;
+  let saveStarted;
+  const started = new Promise((resolve) => { saveStarted = resolve; });
+  const persisted = new Promise((resolve) => { finishSave = resolve; });
+  const failures = { save() { saveStarted(); return persisted; } };
+  const transport = recordingTransport([{ ok: false, retryable: false }]);
+  const service = createDeliveryWorkflow({ transport, failures, clock: createClock() });
+  let settled = false;
+  const delivery = service.deliver({ id: "async-save", type: "invoice.ready" });
+  delivery.then(() => { settled = true; });
+
+  await started;
+  await Promise.resolve();
+  assert.equal(settled, false);
+  finishSave();
+  assert.equal((await delivery).status, "failed");
+});
