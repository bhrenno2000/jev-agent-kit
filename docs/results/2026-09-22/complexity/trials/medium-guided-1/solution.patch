+  const saveStarted = new Promise((resolve) => { startSave = resolve; });
+  const failures = { save(record) { startSave(record); return pendingSave; } };
+  const service = createDeliveryWorkflow({ transport: createTransport([{ ok: false }]), failures, clock: createClock() });
+  let settled = false;
+  const delivery = service.deliver({ id: "pending-save", type: "invoice.ready" }).then((result) => { settled = true; return result; });
+  const record = await saveStarted;
