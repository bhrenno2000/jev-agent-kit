+test("transports receive a deeply immutable snapshot throughout retries", async () => {
+  const event = { id: "snapshot", type: "invoice.ready", payload: { items: [{ amount: 42 }] }, metadata: { source: "billing" } };
+  const original = structuredClone(event);
+  const received = [];
+  const transport = {
+    async send(snapshot) {
+      received.push(snapshot);
+      assert.notEqual(snapshot, event);
+      assert.notEqual(snapshot.payload, event.payload);
+      assert.equal(Object.isFrozen(snapshot), true);
+      assert.equal(Object.isFrozen(snapshot.payload), true);
+      assert.equal(Object.isFrozen(snapshot.payload.items), true);
+      assert.equal(Object.isFrozen(snapshot.payload.items[0]), true);
+      assert.equal(Object.isFrozen(snapshot.metadata), true);
+      assert.equal(Reflect.set(snapshot, "id", "transport-id"), false);
+      assert.equal(Reflect.set(snapshot.payload.items[0], "amount", 999), false);
+      assert.deepEqual(snapshot, original);
+      if (received.length === 1) throw Object.assign(new Error("try again"), { retryable: true });
+    },
+  };
+  const clock = {
+    async sleep(ms) {
+      assert.equal(ms, 100);
+      assert.deepEqual(event, original);
+      assert.equal(Object.isFrozen(event.payload.items[0]), false);
+      event.id = "caller-id";
+      event.payload.items[0].amount = 100;
+    },
+  };
+  const service = createDeliveryWorkflow({ transport, failures: createFailureStore(), clock });
+
+  assert.deepEqual(await service.deliver(event), { eventId: original.id, status: "sent", attempts: 2 });
+  assert.equal(received.length, 2);
+  assert.deepEqual(received, [original, original]);
+  assert.equal(event.id, "caller-id");
+  assert.equal(event.payload.items[0].amount, 100);
+  assert.equal((await service.deliver(original)).duplicate, true);
+});
