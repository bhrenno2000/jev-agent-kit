+test("persistence errors propagate without preventing later delivery", async (t) => {
+  for (const retryable of [false, true]) {
+    for (const asynchronous of [false, true]) {
+      await t.test(`${retryable ? "exhausted" : "permanent"}, ${asynchronous ? "async" : "sync"} store`, async () => {
+        const storageError = Object.assign(new Error("storage unavailable"), { retryable: true });
+        const records = [];
+        const failures = {
+          save(record) {
+            records.push(record);
+            if (asynchronous) return Promise.reject(storageError);
+            throw storageError;
+          },
+        };
+        const outcomes = Array.from({ length: retryable ? 2 : 1 }, () => ({ ok: false, retryable }));
+        const scripted = createTransport([...outcomes, { ok: true }]);
+        let calls = 0;
+        const transport = { send(event) { calls += 1; return scripted.send(event); } };
+        const clock = createClock();
+        const service = createDeliveryWorkflow({ transport, failures, clock, maxAttempts: 2 });
+        const event = { id: "storage-recovery", type: "invoice.ready", payload: { amount: 42 } };
+
+        await assert.rejects(service.deliver(event), (error) => error === storageError);
+        assert.equal(calls, outcomes.length);
+        assert.equal(records.length, 1);
+        assert.deepEqual(records[0].event, event);
+        assert.deepEqual(await service.deliver(event), { eventId: event.id, status: "sent", attempts: 1 });
+        assert.equal(calls, outcomes.length + 1);
+        assert.equal((await service.deliver(event)).duplicate, true);
+        assert.equal(calls, outcomes.length + 1);
