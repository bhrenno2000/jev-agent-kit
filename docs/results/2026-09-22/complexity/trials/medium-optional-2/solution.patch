+test("exhaustion respects the attempt budget and leaves failed IDs retryable", async () => {
+  for (const maxAttempts of [1, 3, 7]) {
+    const clock = createClock();
+    const failures = createFailureStore();
+    let calls = 0;
+    const transport = {
+      async send() {
+        calls += 1;
+        if (calls <= maxAttempts) throw Object.assign(new Error("temporarily unavailable"), { retryable: true });
+      },
+    };
+    const service = createDeliveryWorkflow({ transport, failures, clock, maxAttempts });
+    const event = { id: `exhausted-${maxAttempts}`, type: "invoice.ready" };
+    const result = await service.deliver(event);
+    assert.deepEqual(result, { eventId: event.id, status: "failed", attempts: maxAttempts, error: "temporarily unavailable" });
+    assert.equal(calls, maxAttempts);
+    assert.deepEqual(clock.waits(), [100, 200, 400, 800, 1600, 2000].slice(0, maxAttempts - 1));
+    assert.deepEqual(failures.all(), [result]);
+    assert.deepEqual(await service.deliver(event), { eventId: event.id, status: "sent", attempts: 1 });
+    assert.equal(calls, maxAttempts + 1);
+  }
+});
