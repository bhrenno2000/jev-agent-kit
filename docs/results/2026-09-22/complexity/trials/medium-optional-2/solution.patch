+test("failed deliveries remain retryable when persistence throws or rejects", async () => {
+  for (const retryable of [false, true]) {
+    for (const asynchronous of [false, true]) {
+      const persistenceError = new Error("storage unavailable");
+      const saved = [];
+      const save = (record) => {
+        saved.push(record);
+        throw persistenceError;
+      };
+      const failures = { save: asynchronous ? async (record) => save(record) : save };
+      const transport = createTransport([{ ok: false, retryable }, { ok: true }]);
+      const clock = createClock();
+      const service = createDeliveryWorkflow({ transport, failures, clock, maxAttempts: 1 });
+      const event = { id: `storage-${retryable}-${asynchronous}`, type: "invoice.ready" };
+      await assert.rejects(service.deliver(event), (error) => error === persistenceError);
+      assert.deepEqual(saved, [{ eventId: event.id, attempts: 1, status: "failed", error: "delivery failed" }]);
+      assert.deepEqual(clock.waits(), []);
+      assert.deepEqual(await service.deliver(event), { eventId: event.id, status: "sent", attempts: 1 });
+      assert.equal(transport.sent().length, 1);
+    }
+  }
+});
