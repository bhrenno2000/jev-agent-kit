+test("transports receive a deeply frozen snapshot with event data preserved", async () => {
+  const event = {
+    id: "immutable",
+    type: "invoice.ready",
+    payload: { items: [{ amount: 10n }], optional: undefined, date: new Date("2026-01-01T00:00:00Z") },
+  };
+  event.payload.parent = event;
+  const original = structuredClone(event);
+  const received = [];
+  const transport = {
+    async send(snapshot) {
+      received.push(snapshot);
+      assert.notEqual(snapshot, event);
+      assert.notEqual(snapshot.payload, event.payload);
+      assert.deepEqual(snapshot, original);
+      assert.equal(snapshot.payload.parent, snapshot);
+      for (const value of [snapshot, snapshot.payload, snapshot.payload.items, snapshot.payload.items[0]]) {
+        assert.equal(Object.isFrozen(value), true);
+      }
+      assert.equal(Reflect.set(snapshot, "id", "changed"), false);
+      assert.equal(Reflect.set(snapshot.payload.items[0], "amount", 99n), false);
+      assert.throws(() => snapshot.payload.items.push({ amount: 20n }), TypeError);
+      snapshot.payload.date.setUTCFullYear(2030);
+      if (received.length === 1) throw Object.assign(new Error("retry"), { retryable: true });
+    },
+  };
+  const clock = createClock();
+  const service = createDeliveryWorkflow({ transport, failures: createFailureStore(), clock });
+  assert.deepEqual(await service.deliver(event), { eventId: event.id, status: "sent", attempts: 2 });
+  assert.equal(received.length, 2);
+  assert.deepEqual(event, original);
+  assert.equal(Object.isFrozen(event), false);
+  assert.equal(Object.isFrozen(event.payload.items[0]), false);
+  event.payload.items[0].amount = 20n;
+  assert.equal(received[0].payload.items[0].amount, 10n);
+});
