+test("delivery waits for failure persistence to finish", async () => {
+  let completeSave;
+  const saved = [];
+  const failures = {
+    async save(record) {
+      await new Promise((resolve) => { completeSave = resolve; });
+      saved.push(record);
+    },
+  };
+  const transport = createTransport([{ ok: false, retryable: false }]);
+  const service = createDeliveryWorkflow({ transport, failures, clock: createClock() });
+  let completed = false;
+  const delivery = service.deliver({ id: "async-store", type: "invoice.ready" }).then((result) => {
+    completed = true;
+    return result;
+  });
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(completed, false);
+  assert.deepEqual(saved, []);
+  completeSave();
+  assert.deepEqual(saved, [await delivery]);
+});
