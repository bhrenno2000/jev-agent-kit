+test("backoff starts at the base delay and doubles up to the cap", () => {
+  const backoff = createBackoff();
+  assert.deepEqual(Array.from({ length: 7 }, (_, index) => backoff.delay(index + 1)), [100, 200, 400, 800, 1600, 2000, 2000]);
+  const custom = createBackoff({ baseMs: 30, capMs: 100 });
+  assert.deepEqual([1, 2, 3, 4].map((attempt) => custom.delay(attempt)), [30, 60, 100, 100]);
+});
+
+test("succeeds on the last allowed attempt and deduplicates the event ID", async () => {
+  const clock = createClock();
+  const failures = createFailureStore();
+  const transport = createTransport([{ ok: false, retryable: true }, { ok: false, retryable: true }, { ok: true }]);
+  const service = createDeliveryWorkflow({ transport, failures, clock, maxAttempts: 3 });
+  const event = { id: "last-attempt", type: "invoice.ready", payload: { amount: 10 } };
+  const result = await service.deliver(event);
+  assert.deepEqual(result, { eventId: event.id, status: "sent", attempts: 3 });
+  assert.deepEqual(await service.deliver({ ...event, payload: { amount: 20 } }), { ...result, duplicate: true });
+  assert.deepEqual(clock.waits(), [100, 200]);
+  assert.deepEqual(failures.all(), []);
+  assert.deepEqual(transport.sent(), [event]);
+});
