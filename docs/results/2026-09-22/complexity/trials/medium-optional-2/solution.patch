+test("concurrent deliveries of one event share the send and deduplicate success", async () => {
+  let finish;
+  let calls = 0;
+  const transport = {
+    async send() {
+      calls += 1;
+      await new Promise((resolve) => { finish = resolve; });
+    },
+  };
+  const service = createDeliveryWorkflow({ transport, failures: createFailureStore(), clock: createClock() });
+  const event = { id: "concurrent", type: "invoice.ready" };
+  const first = service.deliver(event);
+  const second = service.deliver(event);
+  assert.equal(calls, 1);
+  finish();
+  const result = await first;
+  assert.deepEqual(result, { eventId: event.id, status: "sent", attempts: 1 });
+  assert.deepEqual(await second, { ...result, duplicate: true });
+  assert.deepEqual(await service.deliver(event), { ...result, duplicate: true });
+  assert.equal(calls, 1);
+});
