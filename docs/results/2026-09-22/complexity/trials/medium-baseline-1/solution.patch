+  const mutationResults = [];
+  const transport = {
+    async send(snapshot) {
+      received = snapshot;
+      mutationResults.push(Reflect.set(snapshot, "id", "changed"));
+      mutationResults.push(Reflect.set(snapshot.payload, "optional", "changed"));
+      mutationResults.push(Reflect.set(snapshot.payload.items[0], "amount", 99));
+      mutationResults.push(Reflect.set(snapshot.payload.items, "0", null));
+    },
