+test("retries and deduplication use the original snapshot when caller data changes", async () => {
+  const event = { id: "original-id", type: "invoice.ready", payload: { amount: 10 } };
+  const expected = structuredClone(event);
+  const received = [];
+  let release;
+  const gate = new Promise((resolve) => { release = resolve; });
+  let started;
+  const sending = new Promise((resolve) => { started = resolve; });
+  const transport = {
+    async send(snapshot) {
+      received.push(snapshot);
+      if (received.length === 1) {
+        started();
+        await gate;
+        throw Object.assign(new Error("temporary"), { retryable: true });
+      }
+    },
+  };
+  const service = createDeliveryWorkflow({ transport, failures: createFailureStore(), clock: createClock() });
+  const delivery = service.deliver(event);
+  await sending;
+  event.id = "changed-id";
+  event.payload.amount = 99;
+  release();
+  assert.deepEqual(await delivery, { eventId: "original-id", status: "sent", attempts: 2 });
+  assert.deepEqual(received, [expected, expected]);
+  assert.deepEqual(await service.deliver(expected), { eventId: "original-id", status: "sent", attempts: 2, duplicate: true });
+  assert.equal(received.length, 2);
+});
