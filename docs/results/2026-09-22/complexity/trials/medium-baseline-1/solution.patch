+test("failed delivery waits for persistence to complete", async () => {
+  let release;
+  const gate = new Promise((resolve) => { release = resolve; });
+  let started;
+  const saving = new Promise((resolve) => { started = resolve; });
+  const records = [];
+  const failures = {
+    async save(record) {
+      started();
+      await gate;
+      records.push(record);
+    },
+  };
+  const transport = createTransport([{ ok: false, retryable: false }]);
+  const service = createDeliveryWorkflow({ transport, failures, clock: createClock() });
+  let settled = false;
+  const delivery = service.deliver({ id: "async-store", type: "invoice.ready" }).then((result) => {
+    settled = true;
+    return result;
+  });
+  await saving;
+  await Promise.resolve();
+  const settledBeforePersistence = settled;
+  release();
+  const result = await delivery;
+  assert.equal(settledBeforePersistence, false);
+  assert.deepEqual(records, [result]);
+});
