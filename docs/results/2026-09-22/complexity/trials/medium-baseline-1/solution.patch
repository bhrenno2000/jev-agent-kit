+  const service = createDeliveryWorkflow({ transport, failures: createFailureStore(), clock: createClock() });
+  assert.deepEqual(await service.deliver(event), { eventId: "immutable", status: "sent", attempts: 1 });
+  assert.deepEqual(mutationResults, [false, false, false, false]);
+  for (const value of [received, received.payload, received.payload.items, received.payload.items[0]]) assert.equal(Object.isFrozen(value), true);
+  assert.notEqual(received, event);
+  assert.notEqual(received.payload, event.payload);
+  assert.deepEqual(received, expected);
+  assert.deepEqual(event, expected);
