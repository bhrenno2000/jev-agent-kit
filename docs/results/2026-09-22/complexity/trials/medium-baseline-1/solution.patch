+test("persistence errors propagate and leave failed deliveries retryable", async (t) => {
+  for (const retryable of [false, true]) {
+    for (const asynchronous of [false, true]) {
+      await t.test(`${retryable ? "exhausted" : "permanent"} failure with ${asynchronous ? "asynchronous" : "synchronous"} persistence`, async () => {
+        const persistenceError = Object.assign(new Error("store unavailable"), { retryable: true });
+        const saved = [];
+        const save = (record) => {
+          saved.push(record);
+          throw persistenceError;
+        };
+        const failures = { save: asynchronous ? async (record) => save(record) : save };
+        const clock = createClock();
+        let calls = 0;
+        const transport = {
+          async send() {
+            calls += 1;
+            if (calls <= (retryable ? 2 : 1)) throw Object.assign(new Error("send failed"), { retryable });
+          },
+        };
+        const service = createDeliveryWorkflow({ transport, failures, clock, maxAttempts: 2 });
+        const event = { id: "store-failure", type: "invoice.ready" };
+        await assert.rejects(service.deliver(event), (error) => error === persistenceError);
+        assert.equal(calls, retryable ? 2 : 1);
+        assert.deepEqual(saved, [{ eventId: event.id, attempts: calls, status: "failed", error: "send failed" }]);
+        assert.deepEqual(await service.deliver(event), { eventId: event.id, status: "sent", attempts: 1 });
+        assert.deepEqual(await service.deliver(event), { eventId: event.id, status: "sent", attempts: 1, duplicate: true });
+        assert.equal(calls, retryable ? 3 : 2);
+        assert.deepEqual(clock.waits(), retryable ? [100] : []);
+      });
+    }
+  }
+});
