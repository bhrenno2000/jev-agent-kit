+test("backoff starts at the base delay and doubles up to the cap", () => {
+  const backoff = createBackoff();
+  assert.deepEqual([1, 2, 3, 4, 5, 6, 7].map((attempt) => backoff.delay(attempt)), [100, 200, 400, 800, 1600, 2000, 2000]);
+  const custom = createBackoff({ baseMs: 25, capMs: 60 });
+  assert.deepEqual([1, 2, 3, 4].map((attempt) => custom.delay(attempt)), [25, 50, 60, 60]);
+});
+
+test("succeeds on the final allowed attempt with the configured backoff", async () => {
